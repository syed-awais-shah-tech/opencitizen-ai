# ==============================================================================
# OpenCitizen AI - Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets/
credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# Node & Next.js
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Next.js build output & cache
.next/
out/
build/
dist/
.turbo/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python packaging & distribution
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python testing & linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# ------------------------------------------------------------------------------
# Analytical & Vector DB Local Data Files
# ------------------------------------------------------------------------------
*.duckdb
*.duckdb.wal
qdrant_storage/
postgres_data/
storage/
*.parquet.tmp
*.sqlite3

# ------------------------------------------------------------------------------
# Docker & Local Infrastructure
# ------------------------------------------------------------------------------
.docker/
docker-compose.override.yml

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
