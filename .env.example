# ==============================================================================
# OpenCitizen AI - Environment Configuration Example
# Copy this file to .env for local development
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME=OpenCitizen AI API
VERSION=0.1.0

# API Settings
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Application Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=opencitizen
POSTGRES_PASSWORD=opencitizen_dev_password
POSTGRES_DB=opencitizen_app
DATABASE_URL=postgresql+psycopg://opencitizen:opencitizen_dev_password@localhost:5432/opencitizen_app

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=opencitizen_documents
QDRANT_URL=
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSION=384

